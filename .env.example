# Credentials for the REAL adapters. The prototype does not need any of these.
# A fresh clone runs end to end on mock adapters at zero cost. Copy this file
# to .env and fill it in only when you wire up a real provider.
#
# .env is gitignored. Never commit a real key.

# HeyReach, reads replies and sends messages.  https://app.heyreach.io
HEYREACH_API_KEY=replace-me
HEYREACH_API_BASE=https://api.heyreach.io/api/public

# Anthropic, classifies replies.  https://console.anthropic.com
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gamma, generates the slide deck.  https://gamma.app
GAMMA_API_KEY=replace-me

# HeyGen, generates the avatar video.  https://heygen.com
HEYGEN_API_KEY=replace-me
# Optional. Which avatar and voice to use. Find the ids in the HeyGen dashboard.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ElevenLabs, optional, for audio on its own.  https://elevenlabs.io
# To use an ElevenLabs voice inside the video, set HEYGEN_VOICE_ID instead.
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_ID=

# Google Gemini, generates the single page visual.  https://aistudio.google.com
GEMINI_API_KEY=replace-me
# Optional. Defaults to gemini-2.5-flash-image.
GEMINI_MODEL=

# Google Sheets sink, the one real adapter that is implemented.
# Either the path to a service account json file, which needs
# pip install "followups[sheets]", or an OAuth access token, which needs
# nothing. Share the sheet with the service account before the first sync.
GOOGLE_SHEETS_CREDENTIALS=replace-me
GOOGLE_SHEETS_SPREADSHEET_ID=replace-me
GOOGLE_SHEETS_TAB=Follow-ups
